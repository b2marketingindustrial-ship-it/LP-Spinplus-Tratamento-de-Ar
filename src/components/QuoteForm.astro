---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4), com o desvio aprovado pelo cliente em
 * 19/10/2026: texto à esquerda e o espaço do formulário à direita (o padrão põe o
 * formulário à esquerda). Registrado em docs/BRIEFING.md (Desvios do padrão).
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * O card da direita fica vazio de propósito: nele entra só o shortcode, que o plugin de
 * atendimento do WordPress troca pelo formulário. Ele não define fonte, cor nem alinhamento
 * do conteúdo, para não interferir no layout do formulário que o plugin renderiza.
 */
import Icon from './Icon.astro'
import Eyebrow from './Eyebrow.astro'
import { quote, cta } from '../data/content'
---

<section id="cotacao" class="bg-neutral-gray-100 pt-8 pb-20">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="quote-grid mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:items-center lg:gap-14">
      {/* Coluna de texto */}
      <div>
        <Eyebrow>{quote.eyebrow}</Eyebrow>

        <h2 class="mt-4 font-display text-[2.25rem] leading-[1.05] font-extrabold tracking-[-0.015em] sm:text-[2.75rem] lg:text-[3rem] text-primary-dark">
          {quote.title}
        </h2>

        <p class="mt-5 max-w-[520px] font-sans text-base leading-relaxed lg:text-[17px] text-ink-soft">
          {quote.text}
        </p>

        <button
          type="button"
          data-cta="cotacao-whatsapp"
          class="btn-slave-whats mt-6 inline-flex w-full items-center justify-center gap-3 bg-primary-dark px-7 py-4 font-sans text-base font-bold text-neutral-light transition-colors duration-200 hover:bg-primary-dark-800 sm:w-auto"
        >
          <Icon name="whatsapp" class="size-6 shrink-0" />
          {cta.whatsapp}
        </button>

        <ul class="mt-6 flex flex-col gap-3">
          {quote.trust.map((item) => (
            <li class="flex items-center gap-2.5 font-sans text-[15px] text-ink">
              <Icon name={item.icon} class="size-6 shrink-0 text-accent-orange" />
              {item.label}
            </li>
          ))}
        </ul>
      </div>

      {/* Espaço do formulário: só a área onde o plugin renderiza o shortcode, sem caixa */}
      <div class="w-full lg:ml-auto lg:max-w-[560px]">
        <div class="quote-slot min-h-[360px] w-full">
          <slot name="shortcode" />
        </div>
      </div>
    </div>
  </div>
</section>
